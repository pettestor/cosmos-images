Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

%post
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip
    rm -rf /var/lib/apt/lists/*

    python3 -m pip install --no-cache-dir cellbender

%runscript
    exec cellbender "$@"